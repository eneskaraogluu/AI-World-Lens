APP_NAME=AI_World_Lens

# SQL Server configuration
DB_SERVER=.\SQLEXPRESS
DB_DATABASE=WorldLensDB
DB_DRIVER=ODBC Driver 17 for SQL Server
# Optional: when set, this overrides the SQL Server fields above.
# DATABASE_URL=sqlite:///./world_lens.db

# Required services
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=your_openai_api_key

# Vision failover (fallback is offered explicitly and never starts silently)
PRIMARY_VISION_PROVIDER=gemini
FALLBACK_VISION_PROVIDER=openai
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_VISION_DETAIL=low
OPENAI_VISION_TIMEOUT_SECONDS=60
VISION_WORKERS=2
# Development/testing only. Keep false in normal runs.
VISION_TEST_SIMULATE_GEMINI_QUOTA=false

# Image generation (OpenAI is the default)
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=1024x1024
# Presentation-ready new research waves: use medium and 1536x1024 consistently.
# OPENAI_IMAGE_QUALITY=medium
# OPENAI_IMAGE_SIZE=1536x1024
OPENAI_TIMEOUT_SECONDS=180

# Optional legacy provider (used only with IMAGE_PROVIDER=pollinations)
# POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=flux

# Reliability settings
QUEUE_WORKERS=2
RUN_ITERATIONS=10
POLLINATIONS_MIN_INTERVAL_SECONDS=8
POLLINATIONS_TIMEOUT_SECONDS=60
